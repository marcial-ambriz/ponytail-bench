diff --git a/CTFd/utils/scores/__init__.py b/CTFd/utils/scores/__init__.py
index 8540f25e..b87117a8 100644
--- a/CTFd/utils/scores/__init__.py
+++ b/CTFd/utils/scores/__init__.py
@@ -331,3 +331,41 @@ def get_user_standings(count=None, bracket_id=None, admin=False, fields=None):
         standings = standings_query.limit(count).all()
 
     return standings
+
+
+def lock_account_row(user, team=None):
+    """Serialise score-changing writes for one account inside the current transaction.
+
+    Issues a no-op UPDATE on the account's row: it takes the row lock on PostgreSQL/MySQL
+    and the database write lock on SQLite, and both are held until the caller commits or
+    rolls back. Callers must do their reads *after* this so they see committed data.
+    """
+    model = Teams if team is not None else Users
+    account_id = team.id if team is not None else user.id
+    table = model.__table__
+    db.session.execute(
+        table.update().where(table.c.id == account_id).values(id=table.c.id)
+    )
+
+
+def get_uncached_account_score(user, team=None):
+    """Current full score (solves + awards, ignoring freeze) read straight from the DB."""
+    if team is not None:
+        solve_cond = Solves.team_id == team.id
+        award_cond = Awards.team_id == team.id
+    else:
+        solve_cond = Solves.user_id == user.id
+        award_cond = Awards.user_id == user.id
+    solves = (
+        db.session.query(db.func.coalesce(db.func.sum(Challenges.value), 0))
+        .select_from(Solves)
+        .join(Challenges, Solves.challenge_id == Challenges.id)
+        .filter(solve_cond)
+        .scalar()
+    )
+    awards = (
+        db.session.query(db.func.coalesce(db.func.sum(Awards.value), 0))
+        .filter(award_cond)
+        .scalar()
+    )
+    return int(solves or 0) + int(awards or 0)
diff --git a/CTFd/utils/teams/__init__.py b/CTFd/utils/teams/__init__.py
new file mode 100644
index 00000000..0d962b6c
--- /dev/null
+++ b/CTFd/utils/teams/__init__.py
@@ -0,0 +1,59 @@
+from sqlalchemy import and_, func, select
+
+from CTFd.models import Teams, Users, db
+from CTFd.utils import get_config
+
+
+def get_member_limit(member_limit):
+    """Seat limit for a team given its own override (0 means unlimited)."""
+    if member_limit:
+        return int(member_limit)
+    return int(get_config("team_size", default=0) or 0)
+
+
+def join_team(user_id, team_id):
+    """Atomically put a team-less user on a team if the team still has a free seat.
+
+    The seat check and the membership write happen in one conditional UPDATE, so
+    simultaneous joins cannot overfill a team (SQLite serialises writers for the whole
+    statement). On databases with row locks the team row is locked first so the seat
+    count cannot be read stale by a concurrent transaction.
+
+    Returns True when the user joined, False when the team is full or the user already
+    belongs to a team.
+    """
+    row = (
+        db.session.query(Teams.id, Teams.member_limit, Teams.captain_id)
+        .filter(Teams.id == team_id)
+        .with_for_update()
+        .first()
+    )
+    if row is None:
+        db.session.rollback()
+        return False
+    limit = get_member_limit(row.member_limit)
+
+    users = Users.__table__
+    conditions = [users.c.id == user_id, users.c.team_id.is_(None)]
+    if limit:
+        seat_users = users.alias("seat_users")
+        seats_taken = (
+            select(func.count(seat_users.c.id))
+            .where(seat_users.c.team_id == team_id)
+            .scalar_subquery()
+        )
+        conditions.append(seats_taken < limit)
+
+    result = db.session.execute(
+        users.update().where(and_(*conditions)).values(team_id=team_id)
+    )
+    joined = result.rowcount == 1
+    if joined and row.captain_id is None:
+        db.session.execute(
+            Teams.__table__.update()
+            .where(Teams.__table__.c.id == team_id)
+            .values(captain_id=user_id)
+        )
+    db.session.commit()
+    db.session.expire_all()
+    return joined
