diff --git a/apps/web/src/routes/cycle-counts.tsx b/apps/web/src/routes/cycle-counts.tsx
new file mode 100644
index 0000000..c8d33d5
--- /dev/null
+++ b/apps/web/src/routes/cycle-counts.tsx
@@ -0,0 +1,200 @@
+import { queryOptions, useQuery, useQueryClient, useSuspenseQuery } from "@tanstack/react-query";
+import { useState } from "react";
+
+import { ErrorAlert, StatusMessage } from "@/components/Alert.tsx";
+import { Card, Loading, PageHeader } from "@/components/Page.tsx";
+import { PendingButton } from "@/components/PendingButton.tsx";
+import { SelectField } from "@/components/Select.tsx";
+import { cellClass, DataTable, EmptyState } from "@/components/Table.tsx";
+import { inputClass, primaryButton, secondaryButton } from "@/components/ui.ts";
+import { useAction } from "@/components/useAction.ts";
+import { api, errorMessage } from "@/lib/api.ts";
+import { meQuery } from "@/lib/auth.ts";
+import { warehousesQuery } from "@/lib/inventory.ts";
+
+interface CycleCount {
+  id: string;
+  warehouseId: string;
+  status: "open" | "posted" | "cancelled";
+  createdAt: string;
+  lines: { variantId: string; sku: string; expected: number; counted: number | null }[];
+}
+
+const countsQuery = queryOptions({
+  queryKey: ["cycle-counts"],
+  queryFn: () => api<CycleCount[]>("/api/cycle-counts"),
+});
+
+function OpenCount({
+  count,
+  warehouseName,
+  isAdmin,
+  onPosted,
+}: {
+  count: CycleCount;
+  warehouseName: string;
+  isAdmin: boolean;
+  onPosted: () => void;
+}) {
+  const queryClient = useQueryClient();
+  const [values, setValues] = useState<Record<string, string>>(() =>
+    Object.fromEntries(
+      count.lines.map((l) => [l.variantId, l.counted === null ? "" : String(l.counted)]),
+    ),
+  );
+  const save = useAction();
+  const post = useAction();
+  const refresh = () => queryClient.invalidateQueries();
+
+  const saveAll = async () => {
+    const filled = count.lines.filter((l) => (values[l.variantId] ?? "").trim() !== "");
+    await Promise.all(
+      filled.map((l) =>
+        api(`/api/cycle-counts/${count.id}/lines/${l.variantId}`, {
+          method: "PUT",
+          body: { counted: Number(values[l.variantId]) },
+        }),
+      ),
+    );
+  };
+
+  return (
+    <Card>
+      <h2 className="mb-3 text-lg font-semibold">Count in {warehouseName}</h2>
+      <DataTable
+        headers={["SKU", "Expected", "Counted"]}
+        empty={count.lines.length === 0 && <EmptyState>No stock in this warehouse</EmptyState>}
+      >
+        {count.lines.map((l) => (
+          <tr key={l.variantId}>
+            <td className={`${cellClass} font-mono`}>{l.sku}</td>
+            <td className={cellClass}>{l.expected}</td>
+            <td className={cellClass}>
+              <label htmlFor={`counted-${count.id}-${l.variantId}`} className="sr-only">
+                Counted {l.sku}
+              </label>
+              <input
+                id={`counted-${count.id}-${l.variantId}`}
+                type="number"
+                inputMode="numeric"
+                className={`${inputClass} max-w-28`}
+                value={values[l.variantId] ?? ""}
+                onChange={(e) => setValues((v) => ({ ...v, [l.variantId]: e.target.value }))}
+              />
+            </td>
+          </tr>
+        ))}
+      </DataTable>
+      <div className="mt-3 flex flex-col gap-2">
+        <ErrorAlert message={post.error ?? save.error} />
+        <StatusMessage message={save.success} />
+        <div className="flex flex-wrap gap-2">
+          <PendingButton
+            type="button"
+            pending={save.pending}
+            className={secondaryButton}
+            onClick={() => void save.run(() => saveAll().then(refresh), "Counts saved")}
+          >
+            Save counts
+          </PendingButton>
+          {isAdmin && (
+            <PendingButton
+              type="button"
+              pending={post.pending}
+              className={primaryButton}
+              onClick={() =>
+                void post.run(async () => {
+                  await saveAll();
+                  await api(`/api/cycle-counts/${count.id}/post`, { body: {} });
+                  onPosted();
+                  await refresh();
+                })
+              }
+            >
+              Post count
+            </PendingButton>
+          )}
+        </div>
+      </div>
+    </Card>
+  );
+}
+
+export function CycleCountsPage() {
+  const { data: user } = useSuspenseQuery(meQuery);
+  const isAdmin = user?.role === "admin";
+  const queryClient = useQueryClient();
+  const warehouses = useQuery(warehousesQuery);
+  const counts = useQuery(countsQuery);
+  const [warehouseId, setWarehouseId] = useState("");
+  const startAction = useAction();
+  const [notice, setNotice] = useState<string | null>(null);
+  const list = warehouses.data ?? [];
+  const selected = warehouseId || list[0]?.id || "";
+  const name = (id: string) => list.find((w) => w.id === id)?.name ?? id;
+
+  return (
+    <div>
+      <PageHeader title="Cycle counts" />
+      <div className="mb-4">
+        <StatusMessage message={notice} />
+      </div>
+      {isAdmin && (
+        <div className="mb-6 flex flex-wrap items-end gap-3">
+          <div className="w-full max-w-xs">
+            <SelectField
+              label="Warehouse"
+              value={selected}
+              onChange={(e) => setWarehouseId(e.target.value)}
+            >
+              {list.map((w) => (
+                <option key={w.id} value={w.id}>
+                  {w.name}
+                </option>
+              ))}
+            </SelectField>
+          </div>
+          <PendingButton
+            type="button"
+            pending={startAction.pending}
+            className={primaryButton}
+            onClick={() =>
+              void startAction.run(() =>
+                api("/api/cycle-counts", { body: { warehouseId: selected } }).then(() =>
+                  queryClient.invalidateQueries({ queryKey: ["cycle-counts"] }),
+                ),
+              )
+            }
+          >
+            Start count
+          </PendingButton>
+          <div className="w-full">
+            <ErrorAlert message={startAction.error} />
+          </div>
+        </div>
+      )}
+      {counts.isPending ? (
+        <Loading />
+      ) : counts.isError ? (
+        <ErrorAlert message={errorMessage(counts.error)} />
+      ) : (
+        <div className="flex flex-col gap-4">
+          {counts.data.filter((c) => c.status === "open").length === 0 && (
+            <p className="text-sm text-slate-500">No open counts</p>
+          )}
+          {counts.data
+            .filter((c) => c.status === "open")
+            .map((c) => (
+              <OpenCount
+                key={c.id}
+                count={c}
+                warehouseName={name(c.warehouseId)}
+                isAdmin={isAdmin}
+                onPosted={() => setNotice("Count posted")}
+              />
+            ))}
+        </div>
+      )}
+    </div>
+  );
+}
