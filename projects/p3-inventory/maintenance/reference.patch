diff --git a/apps/api/src/routes/cycle-counts.ts b/apps/api/src/routes/cycle-counts.ts
new file mode 100644
index 0000000..86d9d54
--- /dev/null
+++ b/apps/api/src/routes/cycle-counts.ts
@@ -0,0 +1,179 @@
+import { randomUUID } from "node:crypto";
+
+import { Hono } from "hono";
+import { z } from "zod";
+
+import type { DB } from "../db.js";
+import { applyMovement, findWarehouse, stockRow } from "../domain/inventory.js";
+import { idSchema, MAX_QUANTITY } from "../domain/validation.js";
+import { badRequest, conflict, notFound, readJson } from "../http.js";
+import type { Services } from "../services.js";
+import { requireAdmin, type AppEnv } from "../session.js";
+
+type CountStatus = "open" | "posted" | "cancelled";
+
+const startSchema = z.object({ warehouseId: idSchema });
+const countSchema = z.object({
+  counted: z
+    .number({ error: "Counted must be a whole number" })
+    .int("Counted must be a whole number")
+    .min(0, "Counted must be 0 or more")
+    .max(MAX_QUANTITY, "Counted must be at most 1,000,000"),
+});
+
+interface CountRow {
+  id: string;
+  warehouse_id: string;
+  status: CountStatus;
+  created_at: string;
+  posted_at: string | null;
+}
+
+interface LineRow {
+  variant_id: string;
+  sku: string;
+  expected: number;
+  counted: number | null;
+}
+
+function countRow(db: DB, id: string): CountRow {
+  const row = db
+    .prepare<[string], CountRow>(
+      "SELECT id, warehouse_id, status, created_at, posted_at FROM cycle_count WHERE id = ?",
+    )
+    .get(id);
+  if (!row) throw notFound("Cycle count not found");
+  return row;
+}
+
+function lines(db: DB, id: string): LineRow[] {
+  return db
+    .prepare<[string], LineRow>(
+      `SELECT l.variant_id, v.sku, l.expected, l.counted FROM cycle_count_line l
+       JOIN variant v ON v.id = l.variant_id WHERE l.count_id = ? ORDER BY v.sku`,
+    )
+    .all(id);
+}
+
+function loadCount(db: DB, id: string) {
+  const row = countRow(db, id);
+  return {
+    id: row.id,
+    warehouseId: row.warehouse_id,
+    status: row.status,
+    createdAt: row.created_at,
+    postedAt: row.posted_at,
+    lines: lines(db, id).map((l) => ({
+      variantId: l.variant_id,
+      sku: l.sku,
+      expected: l.expected,
+      counted: l.counted,
+    })),
+  };
+}
+
+export function cycleCountRoutes(services: Services) {
+  const { db } = services;
+  const app = new Hono<AppEnv>();
+
+  app.get("/", (c) =>
+    c.json(
+      db
+        .prepare<[], { id: string }>(
+          "SELECT id FROM cycle_count ORDER BY created_at DESC, rowid DESC",
+        )
+        .all()
+        .map(({ id }) => loadCount(db, id)),
+    ),
+  );
+
+  app.get("/:id", (c) => c.json(loadCount(db, c.req.param("id"))));
+
+  app.post("/", requireAdmin, async (c) => {
+    const { warehouseId } = await readJson(c, startSchema);
+    if (!findWarehouse(db, warehouseId)) throw badRequest(`Unknown warehouse ${warehouseId}`);
+    const id = randomUUID();
+    db.transaction(() => {
+      if (
+        db
+          .prepare("SELECT 1 FROM cycle_count WHERE warehouse_id = ? AND status = 'open'")
+          .get(warehouseId)
+      ) {
+        throw conflict("This warehouse already has an open cycle count");
+      }
+      db.prepare(
+        "INSERT INTO cycle_count (id, warehouse_id, status, created_by, created_at) VALUES (?, ?, 'open', ?, ?)",
+      ).run(id, warehouseId, c.get("user").id, services.now().toISOString());
+      db.prepare(
+        `INSERT INTO cycle_count_line (count_id, variant_id, expected)
+         SELECT ?, variant_id, on_hand FROM stock WHERE warehouse_id = ? AND (on_hand <> 0 OR reserved <> 0)`,
+      ).run(id, warehouseId);
+    }).immediate();
+    return c.json(loadCount(db, id), 201);
+  });
+
+  app.put("/:id/lines/:variantId", async (c) => {
+    const id = c.req.param("id");
+    const { counted } = await readJson(c, countSchema);
+    db.transaction(() => {
+      if (countRow(db, id).status !== "open") throw conflict("This cycle count is not open");
+      const res = db
+        .prepare("UPDATE cycle_count_line SET counted = ? WHERE count_id = ? AND variant_id = ?")
+        .run(counted, id, c.req.param("variantId"));
+      if (res.changes === 0) throw notFound("This variant is not part of the count");
+    }).immediate();
+    return c.json(loadCount(db, id));
+  });
+
+  app.post("/:id/post", requireAdmin, (c) => {
+    const id = c.req.param("id");
+    const userId = c.get("user").id;
+    db.transaction(() => {
+      const count = countRow(db, id);
+      if (count.status !== "open") throw conflict(`This cycle count is ${count.status}`);
+      const all = lines(db, id);
+      if (all.some((l) => l.counted === null)) throw badRequest("Every line must be counted first");
+      const at = services.now().toISOString();
+      for (const line of all) {
+        const counted = line.counted ?? 0;
+        const stock = stockRow(db, line.variant_id, count.warehouse_id);
+        if (counted < stock.reserved) {
+          throw conflict(
+            `${line.sku}: counted ${counted} is below the ${stock.reserved} reserved units`,
+          );
+        }
+        const delta = counted - stock.on_hand;
+        if (delta === 0) continue;
+        applyMovement(db, {
+          variantId: line.variant_id,
+          warehouseId: count.warehouse_id,
+          type: "adjustment",
+          quantity: delta,
+          unitCostCents: null,
+          reason: `Cycle count ${id}`,
+          orderId: null,
+          transferId: null,
+          userId,
+          at,
+        });
+      }
+      db.prepare("UPDATE cycle_count SET status = 'posted', posted_at = ? WHERE id = ?").run(
+        at,
+        id,
+      );
+    }).immediate();
+    return c.json(loadCount(db, id));
+  });
+
+  app.post("/:id/cancel", requireAdmin, (c) => {
+    const id = c.req.param("id");
+    db.transaction(() => {
+      const count = countRow(db, id);
+      if (count.status === "posted") throw conflict("A posted cycle count cannot be cancelled");
+      db.prepare("UPDATE cycle_count SET status = 'cancelled' WHERE id = ?").run(id);
+    }).immediate();
+    return c.json(loadCount(db, id));
+  });
+
+  return app;
+}
