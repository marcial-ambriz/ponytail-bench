      {
        "click": "role=link[name=\"INV-0005\"s]"
      },
      {
        "click": "role=button[name=\"Record payment\"s]"
      },
      {
        "fill": [
          "role=dialog >> role=textbox[name=\"Amount\"s]",
          "999999"
        ]
      },
      {
        "click": "role=dialog >> role=button[name=\"Save payment\"s]"
      },
      {
        "wait": 1500
      }
    ]
