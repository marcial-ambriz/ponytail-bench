    "role": "owner",
    "cp": "cp3",
    "path": "/",
    "state": "error",
    "expect_role": "alert",
    "actions": [
      {
        "click": "role=link[name=\"Northwind Supplies\"s]"
      },
      {
        "waitFor": "role=navigation[name=\"Organization\"s]"
      },
      {
        "click": "role=navigation[name=\"Organization\"s] >> role=link[name=\"Invoices\"s]"
